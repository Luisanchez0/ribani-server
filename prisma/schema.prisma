model zonas_seguras {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adulto_id         String   @db.Uuid
  nombre            String   @db.VarChar(100)
  latitud_centro    Decimal  @db.Decimal(9, 6)
  longitud_centro   Decimal  @db.Decimal(9, 6)
  radio_metros      Int
  notificar_salida  Boolean  @default(true)
  notificar_entrada Boolean  @default(false)
  activa            Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  usuarios          usuarios @relation(fields: [adulto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([adulto_id, nombre])
  @@index([adulto_id], map: "zonas_adulto_activas_idx", where: raw("activa"))
}
