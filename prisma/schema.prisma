model whatsapp_destinatarios {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id              String?                   @db.Uuid
  contacto_emergencia_id  String?                   @db.Uuid
  telefono_e164           String                    @unique @db.VarChar(16)
  nombre                  String?                   @db.VarChar(120)
  consentimiento          String                    @default("PENDIENTE") @db.VarChar(15)
  consentimiento_origen   String?                   @db.VarChar(30)
  consentimiento_en       DateTime?                 @db.Timestamptz(6)
  revocado_en             DateTime?                 @db.Timestamptz(6)
  activo                  Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  notificaciones_whatsapp notificaciones_whatsapp[]
  contactos_emergencia    contactos_emergencia?     @relation(fields: [contacto_emergencia_id], references: [id], onUpdate: NoAction)
  usuarios                usuarios?                 @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([contacto_emergencia_id], map: "wa_destinatarios_contacto_idx", where: raw("activo"))
  @@index([usuario_id], map: "wa_destinatarios_usuario_idx", where: raw("activo"))
}

