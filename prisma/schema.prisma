model whatsapp_estados_proveedor {
  id                      BigInt                  @id @default(autoincrement())
  notificacion_id         String                  @db.Uuid
  proveedor_evento_id     String?                 @unique @db.VarChar(150)
  estado                  String                  @db.VarChar(15)
  ocurrido_en             DateTime                @default(now()) @db.Timestamptz(6)
  codigo_error            String?                 @db.VarChar(40)
  detalle_error           String?                 @db.VarChar(500)
  payload_minimo          Json?
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  notificaciones_whatsapp notificaciones_whatsapp @relation(fields: [notificacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([notificacion_id, ocurrido_en(sort: Desc)], map: "wa_estados_notificacion_fecha_idx")
}

