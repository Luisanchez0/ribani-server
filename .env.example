DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
PORT=3000

# Orígenes permitidos para CORS (separados por coma). Ej: panel React en Vite.
CORS_ORIGINS="http://localhost:5173"

# Clave de cifrado AES-256-GCM para los secretos TOTP del 2FA (32 bytes en base64url)
TWO_FACTOR_ENCRYPTION_KEY="cambia-esto-por-una-clave-base64url-de-32-bytes"
