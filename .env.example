DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
PORT=3000

# Orígenes permitidos para CORS (separados por coma). Ej: panel React en Vite.
CORS_ORIGINS="http://localhost:5173"

# Firma JWT y duraciones en segundos. Sustituir el valor de ejemplo.
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Clave de cifrado AES-256-GCM para los secretos TOTP del 2FA (32 bytes en base64url)
TWO_FACTOR_ENCRYPTION_KEY="cambia-esto-por-una-clave-base64url-de-32-bytes"

# Obligatoria al iniciar el módulo de correo; no colocar una clave real aquí.
RESEND_API_KEY="re_reemplazar_con_tu_clave"
# Opcionales: si quedan vacías se usan las plantillas configuradas en MailService.
RESEND_TEMPLATE_INVITACION_ID=""
RESEND_TEMPLATE_BIENVENIDA_ID=""

# Meta Cloud API: mantener false hasta disponer de cuenta, número y consentimiento.
WHATSAPP_ENABLED=false
WHATSAPP_WORKER_ENABLED=false
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Versión Graph soportada por tu aplicación Meta (p. ej. vXX.X); sin default oculto.
WHATSAPP_API_VERSION=""
META_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Plantillas aprobadas; prueba y recordatorio: cuerpo fijo sin parámetros.
WHATSAPP_TEST_TEMPLATE=""
# Alerta: 4 parámetros de texto en orden: nombre, tipo, título, fecha UTC.
WHATSAPP_ALERT_TEMPLATE=""
WHATSAPP_REMINDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"
# Opcional: plantilla "reset-password" de Resend (código de 6 dígitos para
# recuperar contraseña). Si queda vacía se usa HTML inline con el código.
RESEND_TEMPLATE_RESET_ID=""
