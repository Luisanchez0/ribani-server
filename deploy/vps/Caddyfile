# Caddy termina TLS y reparte dos dominios en la red interna de Docker:
#   API_DOMAIN -> api:3000   (ribani-server)
#   WEB_DOMAIN -> web:80     (panel web, nginx)
# Ambas variables se inyectan desde el .env del compose.
# Caddy añade X-Forwarded-Proto: https, que es lo que Nest valida con
# TRUST_PROXY_HOPS=1 en producción.

{$API_DOMAIN} {
	encode zstd gzip

	reverse_proxy api:3000 {
		# Sin búfer para los streams SSE de ubicaciones y alertas.
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}

{$WEB_DOMAIN} {
	# nginx ya comprime: aquí solo se reenvía el estático del SPA.
	reverse_proxy web:80

	log {
		output stdout
		format console
	}
}

# Landing estática del dominio principal (LANDING_DOMAIN, p. ej. ribani.lat).
# Los archivos se montan desde el repo hermano ../ribani-landing.
{$LANDING_DOMAIN} {
	root * /srv/landing
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# www -> dominio principal
www.{$LANDING_DOMAIN} {
	redir https://{$LANDING_DOMAIN}{uri} permanent
}
