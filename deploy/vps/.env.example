# Copia este archivo como .env en esta misma carpeta (deploy/vps/.env).
# Ese .env NUNCA se versiona; docker compose lo lee para interpolar las variables
# que compose.yaml declara: una variable nueva también debe añadirse allí.

# --- Dominios y proxy ------------------------------------------------------
# Ambos subdominios apuntan al VPS (registros A). Caddy saca los certificados solo.
API_DOMAIN="api.tudominio.com"
WEB_DOMAIN="app.tudominio.com"
# Dominio principal: landing estática (../ribani-landing). www redirige a este.
LANDING_DOMAIN="tudominio.com"
# URL pública de la API que se incrusta en el bundle del panel web al construir.
# Debe ser HTTPS y sin barra final; cambiarla exige `docker compose build web`.
PUBLIC_API_URL="https://api.tudominio.com"

# --- Base de datos (Supabase) ---------------------------------------------
# Pooler 6543 para la app y conexión directa 5432 para Prisma (DIRECT_URL).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Opcional: ruta a otra CA de Supabase; por defecto usa certs/supabase-ca.crt.
# DATABASE_SSL_CA_PATH=/app/certs/supabase-ca.crt

# --- Autenticación ---------------------------------------------------------
# 48 bytes aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="<secreto-de-48-bytes>"
JWT_ACCESS_EXPIRES_IN_SECONDS="900"
JWT_REFRESH_EXPIRES_IN_SECONDS="604800"
# Cifrado AES-256-GCM del secreto TOTP: 32 bytes en base64url.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TWO_FACTOR_ENCRYPTION_KEY="<32-bytes-base64url>"

# --- Correo transaccional (Resend) ----------------------------------------
RESEND_API_KEY="<re_...>"
RESEND_TEMPLATE_INVITACION_ID=""
RESEND_TEMPLATE_BIENVENIDA_ID=""
RESEND_TEMPLATE_RESET_ID=""

# --- CORS ------------------------------------------------------------------
# Origen exacto del panel web, con HTTPS y sin barra final. Varios separados por coma.
CORS_ORIGINS="https://app.tudominio.com"

# --- WhatsApp (Meta Cloud API) --------------------------------------------
# Activar solo con credenciales y plantillas listas (docs/whatsapp.md).
WHATSAPP_ENABLED="false"
WHATSAPP_WORKER_ENABLED="false"
WHATSAPP_REMINDERS_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
META_APP_SECRET=""
# Aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Nombres exactos de plantillas aprobadas en Meta, en el idioma indicado abajo.
WHATSAPP_TEST_TEMPLATE="ribani_prueba"
WHATSAPP_ALERT_TEMPLATE="ribani_alerta_critica"
WHATSAPP_REMINDER_TEMPLATE="ribani_recordatorio_medicamento"
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"

# --- WhatsApp (Evolution API, opcional) -----------------------------------
# Solo desarrollo o demostración con un número desechable (docs/evolution-api.md).
# Para usarla descomenta este bloque y pon WHATSAPP_ENABLED y WHATSAPP_WORKER_ENABLED
# en "true". Con Evolution, los *_TEMPLATE de arriba son etiquetas internas, pero
# deben seguir definidos: sin ellos no se encola nada.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:compose.evolution.yaml
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EVOLUTION_APIKEY="<64-hex>"
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# EVOLUTION_POSTGRES_PASSWORD="<32-hex>"
# WHATSAPP_EVOLUTION_INSTANCE="RibaniNotifications"
